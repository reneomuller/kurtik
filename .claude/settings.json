{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm install *)",
      "Bash(npx tsc *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Read(./.env.local)",
      "Read(./.env)"
    ]
  }
}
